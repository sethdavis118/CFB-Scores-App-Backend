{
  "name": "capstone-backend",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon",
    "db:schema": "psql -U postgres -d cfbodds -f ./src/db/schema.sql",
    "db:seed": "node ./src/db/seed.js",
    "db:seed-debug": "nodemon --inspect ./src/db/seed.js",
    "db:reset": "npm run db:schema && npm run db:seed",
    "debug": "node --inspect ./src/queries/games.js"
  }
}
